{
  "compilerOptions": {
    "target": "esnext",
    // 最终打包为什么的代码
    "module": "esnext",
    // 模块化规范
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "utils/*": [
        "./src/utils/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  }
}